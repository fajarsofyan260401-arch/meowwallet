generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String        @default("Meow Saver")
  email        String        @unique
  passwordHash String
  avatarType   String        @default("SHARK_CAT")
  currency     String        @default("IDR")
  isDemoSeeded Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  assets       Asset[]
  categories   Category[]
  savingsGoals SavingsGoal[]
  transactions Transaction[]
}

model Account {
  id                  String               @id @default(cuid())
  userId              String
  name                String
  type                String
  initialBalance      Int                  @default(0)
  currentBalance      Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsTransactions SavingsTransaction[]
  incomingTransfers   Transaction[]        @relation("DestinationAccount")
  transactions        Transaction[]        @relation("PrimaryAccount")
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         String
  icon         String        @default("Wallet")
  color        String        @default("#DCEFFA")
  isDemo       Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Transaction {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  destinationAccountId String?
  categoryId           String?
  type                 String
  amount               Int
  title                String
  note                 String?
  date                 DateTime  @default(now())
  isDemo               Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  category             Category? @relation(fields: [categoryId], references: [id])
  destinationAccount   Account?  @relation("DestinationAccount", fields: [destinationAccountId], references: [id])
  account              Account   @relation("PrimaryAccount", fields: [accountId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id            String               @id @default(cuid())
  userId        String
  name          String
  mascot        String               @default("STRAWBERRY_CAT")
  targetAmount  Int
  currentAmount Int                  @default(0)
  startDate     DateTime             @default(now())
  deadline      DateTime?
  note          String?
  isDemo        Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  SavingsTransaction[]
}

model SavingsTransaction {
  id            String      @id @default(cuid())
  savingsGoalId String
  accountId     String
  type          String
  amount        Int
  note          String?
  date          DateTime    @default(now())
  isDemo        Boolean     @default(false)
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  savingsGoal   SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String         @id @default(cuid())
  userId       String
  name         String
  category     String
  quantity     Float          @default(1)
  currentValue Int
  note         String?
  isDemo       Boolean        @default(false)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  history      AssetHistory[]
}

model AssetHistory {
  id         String   @id @default(cuid())
  assetId    String
  value      Int
  recordedAt DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
